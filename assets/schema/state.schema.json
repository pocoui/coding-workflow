{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-coding-workflow/schemas/state.schema.json",
  "title": "Workflow State",
  "description": "ai-coding-workflow 工作流状态文件契约（事实来源）",
  "type": "object",
  "required": ["version", "vId", "name", "date", "hash", "status", "step", "createdAt", "updatedAt"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "state.json schema 版本，当前固定为 1"
    },
    "vId": {
      "type": "string",
      "minLength": 1,
      "description": "需求 ID，格式 {name}_{date}_{hash}，如 登录功能_20260806_a3f2b1"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "需求名称（≤10 字中文）"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{8}$",
      "description": "创建日期，格式 YYYYMMDD"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-z0-9]{6}$",
      "description": "6 位随机小写字母数字，用于防碰撞"
    },
    "step": {
      "type": "integer",
      "minimum": 0,
      "description": "大阶段编号（0=未开始, 2=初始化, 3=spec, 4=plan, 5=执行/代码审查, 6=推送）"
    },
    "status": {
      "enum": [
        "initialized",
        "spec_reviewing",
        "spec_confirming",
        "plan_reviewing",
        "plan_confirming",
        "executing",
        "code_reviewing",
        "acceptance",
        "accepted",
        "completed"
      ],
      "description": "当前工作流状态"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "enum": ["fast", "standard", "strict"],
      "description": "Workflow mode. fast uses brief.json; standard is the default; strict keeps full review rounds."
    },
    "specPath": {
      "type": ["string", "null"],
      "description": "spec.md 路径（相对项目根）"
    },
    "planPath": {
      "type": ["string", "null"],
      "description": "plan.md 路径（相对项目根）"
    },
    "briefPath": {
      "type": ["string", "null"],
      "description": "brief.md path for fast mode, relative to project root."
    },
    "currentStep": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "plan 中的当前步骤序号（仅 step=5 时使用）"
    },
    "waitingFor": {
      "type": ["string", "null"],
      "description": "等待用户输入标记（如 user_supplement），null 表示不等待"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxSpecRounds": { "type": "integer", "minimum": 0 },
        "maxPlanRounds": { "type": "integer", "minimum": 0 },
        "maxCodeRounds": { "type": "integer", "minimum": 0 },
        "specRounds": { "type": "integer", "minimum": 0 },
        "planRounds": { "type": "integer", "minimum": 0 },
        "codeRounds": { "type": "integer", "minimum": 0 }
      },
      "description": "Review round limits and counters by phase."
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowedPaths": {
          "type": "array",
          "items": { "type": "string" },
          "description": "允许修改的文件/目录路径列表"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dir": {
          "type": "string",
          "description": "证据目录路径（相对项目根）"
        }
      }
    }
  }
}
